# ==============================================================================
# Oralix Frontend Environment Configuration (.env.example)
# Note: ONLY variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put backend secrets (such as RESEND_API_KEY or SESSION_SECRET) in this file!
# ==============================================================================

# Backend API URL (leave empty or set to /api in same-domain deployments; set to backend host in separated deployments)
# Production: https://api.oralix.online
# Development: http://localhost:3001
VITE_API_URL=http://localhost:3001

# Frontend App URL
# Production: https://oralix.online
# Development: http://localhost:3000
VITE_APP_URL=http://localhost:3000

# Supabase Auth & Google OAuth Credentials
VITE_SUPABASE_URL=https://iycnohkobazaduldxiqc.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
