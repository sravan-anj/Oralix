# ==============================================================================
# Oralix Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the values appropriate for your environment.
# ==============================================================================

# PRODUCTION APPLICATION & FRONTEND URL
# Production: https://oralix.online
# Development: http://localhost:3000
APP_URL="https://oralix.online"
FRONTEND_URL="https://oralix.online"
API_PORT="3001"

# EMAIL PROVIDER CONFIGURATION (Resend Primary - Domain: oralix.online)
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
MAIL_FROM="Oralix <noreply@oralix.online>"
EMAIL_FROM="Oralix <noreply@oralix.online>"

# STABLE AUTHENTICATION SECRETS (Do NOT leave default in production)
FLASK_SECRET_KEY="oralix_stable_production_secret_key_change_me"
SESSION_SECRET="oralix_session_secret_change_me"
AUTH_SECRET="oralix_auth_secret_change_me"
PASSWORD_RESET_SECRET="oralix_password_reset_secret_change_me"

# OPTIONAL SMTP FALLBACK CONFIGURATION (Used if RESEND_API_KEY is unset)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# SMTP_SECURE="false"

# GEMINI AI API (Optional)
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# RAZORPAY PAYMENT GATEWAY CREDENTIALS (Optional)
# VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_RAZORPAY_KEY_ID"
# RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

