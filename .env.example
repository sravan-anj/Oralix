# Oralix – Environment Variables Reference
# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel, add these as Environment Variables in the project dashboard.

# ---------------------------------------------------------------------------
# AI Chatbot (required for generative Gemini responses)
# ---------------------------------------------------------------------------
# Your Google Gemini API key. Obtain one at https://ai.google.dev
# This is read ONLY on the server (api/chat.js). Never expose it to the client.
# Without this key the chatbot will still work using the built-in local workflow.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (required for authentication and data sync)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://iycnohkobazaduldxiqc.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: Supabase service-role key for stronger server-side JWT verification.
# Set this in Vercel Environment Variables (never in client-side code).
# If omitted, the serverless function falls back to the anon key for verification.
SUPABASE_SERVICE_ROLE_KEY=
