# Supabase Edge Functions Environment Variables (Local Development & Testing)
# When running Edge Functions locally using Supabase CLI:
#   supabase functions serve --env-file ./supabase/functions/.env
#
# In production, deploy secrets to Supabase Edge Runtime via:
#   supabase secrets set GOOGLE_CLIENT_ID="your_client_id" GOOGLE_CLIENT_SECRET="your_client_secret"
#
# Do NOT commit production secret values to Git.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
