# ==============================================================================
# DentiFlow / Oralix Backend Environment Configuration (.env.example)
# Copy this file to .env in the backend folder: cp .env.example .env
# ==============================================================================

# SERVER PORT & URLS
API_PORT=3001
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# EMAIL PROVIDER CONFIGURATION (Resend)
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
MAIL_FROM="Oralix <noreply@oralix.online>"
EMAIL_FROM="Oralix <noreply@oralix.online>"

# AUTHENTICATION SECRETS
FLASK_SECRET_KEY="oralix_stable_production_secret_key_change_me"
SESSION_SECRET="oralix_session_secret_change_me"
AUTH_SECRET="oralix_auth_secret_change_me"
PASSWORD_RESET_SECRET="oralix_password_reset_secret_change_me"

# OPTIONAL SMTP FALLBACK (Used if RESEND_API_KEY is unset)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# SMTP_SECURE="false"

# GEMINI AI API (Optional)
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# RAZORPAY PAYMENT GATEWAY CREDENTIALS (Optional)
# RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
